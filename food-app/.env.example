# Copy this file to .env and fill in the values from your Firebase project
# (Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration).
# See README.md for the full setup walkthrough.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Same values, but as one JSON blob — used at build time to inject config
# into the GitHub Pages deployment via a repository secret. Optional for
# local dev (the individual VITE_FIREBASE_* vars above are enough).
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
